# Copy to docker/.env on the server and fill in the values.
# Never commit the real .env file.

TZ=Europe/Kyiv

# Nagios web UI administrator (HTTP basic authentication)
NAGIOS_ADMIN_USER=nagiosadmin
NAGIOS_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# IP address written into the self-signed certificate (monitoring host)
CERT_IP=10.7.99.103
